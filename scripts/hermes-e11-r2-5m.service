[Unit]
Description=Hermes E11 R2-B1 same-browser five-minute CAS renewal experiment
Documentation=file:/home/nancunchild/projects/Hermes/docs/open-questions.md
After=network-online.target graphical-session.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/nancunchild/projects/Hermes
ExecStart=/usr/bin/systemd-inhibit --what=sleep --mode=block --who=Hermes-E11-R2-B1 --why=Keep_E11_R2_B1_browser_and_timeline_alive /home/nancunchild/projects/Hermes/scripts/e11-r2-5m-same-browser.sh
Restart=no
TimeoutStartSec=infinity
KillMode=mixed

StandardOutput=journal
StandardError=journal
SyslogIdentifier=hermes-e11-r2-5m

[Install]
WantedBy=default.target
