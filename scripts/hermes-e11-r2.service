# Template: replace @HERMES_REPO@ with the absolute checkout path before installation.
[Unit]
Description=Hermes E11 R2 silent CAS renewal experiment
Documentation=file:@HERMES_REPO@/docs/open-questions.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@HERMES_REPO@
ExecStart=/usr/bin/systemd-inhibit --what=sleep --mode=block --who=Hermes-E11-R2 --why=Keep_E11_R2_timeline_monotonic @HERMES_REPO@/scripts/e11-r2-silent-renewal.sh
Restart=no
TimeoutStartSec=infinity
KillMode=mixed

StandardOutput=journal
StandardError=journal
SyslogIdentifier=hermes-e11-r2

[Install]
WantedBy=default.target
