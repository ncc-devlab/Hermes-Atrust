# Template: replace @HERMES_REPO@ with the absolute checkout path before installation.
[Unit]
Description=Hermes E11 resume decisive S0/S1 lifetime check
Documentation=file:@HERMES_REPO@/docs/open-questions.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@HERMES_REPO@
ExecStart=/usr/bin/systemd-inhibit --what=sleep --mode=block --who=Hermes-E11-Resume --why=Resume_E11_decisive_lifetime_check @HERMES_REPO@/scripts/e11-headless-resume-monitor.sh
Restart=no
TimeoutStartSec=infinity
KillMode=mixed

StandardOutput=journal
StandardError=journal
SyslogIdentifier=hermes-e11-headless-resume

[Install]
WantedBy=default.target
