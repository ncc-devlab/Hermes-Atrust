[Unit]
Description=Hermes E11 resume decisive S0/S1 lifetime check
Documentation=file:/home/nancunchild/projects/Hermes/docs/open-questions.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/nancunchild/projects/Hermes
ExecStart=/usr/bin/systemd-inhibit --what=sleep --mode=block --who=Hermes-E11-Resume --why=Resume_E11_decisive_lifetime_check /home/nancunchild/projects/Hermes/scripts/e11-headless-resume-monitor.sh
Restart=no
TimeoutStartSec=infinity
KillMode=mixed

StandardOutput=journal
StandardError=journal
SyslogIdentifier=hermes-e11-headless-resume

[Install]
WantedBy=default.target
