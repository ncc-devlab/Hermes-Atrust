[Unit]
Description=Hermes credential-backed serial live observations
Documentation=file:/home/nancunchild/projects/Hermes/docs/credential-live-experiments-2026-08-14.md
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/nancunchild/projects/Hermes
ExecStart=/home/nancunchild/projects/Hermes/scripts/credential-live-observation.sh
TimeoutStartSec=infinity
Restart=no
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hermes-credential-live

[Install]
WantedBy=default.target
