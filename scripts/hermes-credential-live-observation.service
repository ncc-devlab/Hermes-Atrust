# Template: replace @HERMES_REPO@ with the absolute checkout path before installation.
[Unit]
Description=Hermes credential-backed serial live observations
Documentation=file:@HERMES_REPO@/docs/credential-live-experiments-2026-08-14.md
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@HERMES_REPO@
ExecStart=@HERMES_REPO@/scripts/credential-live-observation.sh
TimeoutStartSec=infinity
Restart=no
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hermes-credential-live

[Install]
WantedBy=default.target
